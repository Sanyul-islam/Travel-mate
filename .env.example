# MongoDB Connection String (Atlas or Local)
MONGODB_URI=mongodb://localhost:27017/travel_mate

# JWT Secrets for Authentication Sessions
JWT_ACCESS_SECRET=travel_mate_access_secret_super_secure_key_2026
JWT_REFRESH_SECRET=travel_mate_refresh_secret_super_secure_key_2026

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend Email Configuration (Optional - dev mode logs email links to console)
# RESEND_API_KEY=re_your_api_key_here
# EMAIL_FROM=OrbitTrail <onboarding@resend.dev>

# Cloudinary Configuration (Optional - fallback to local storage if not configured)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# AI Summarization (OpenRouter, Gemini, or fallback heuristic summarizer)
# OPENROUTER_API_KEY=sk-or-v1-...
# AI_MODEL=meta-llama/llama-3-8b-instruct:free
